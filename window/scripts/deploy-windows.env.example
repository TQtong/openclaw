# OpenClaw Windows Deployment Configuration
# Copy this file to deploy-windows.env and edit as needed.
# These values are used by deploy-windows.ps1 if present.

# Gateway port (default: 18789)
# OPENCLAW_GATEWAY_PORT=18789

# Gateway bind address:
#   loopback  - localhost only (most secure, default)
#   lan       - all interfaces (needed for remote access)
# OPENCLAW_GATEWAY_BIND=loopback

# Skip build step (set to 1 if you already built the project)
# OPENCLAW_SKIP_BUILD=0

# Skip onboarding wizard (set to 1 to skip)
# OPENCLAW_SKIP_ONBOARD=0

# Skip auto-start setup (set to 1 to skip Scheduled Task creation)
# OPENCLAW_SKIP_AUTOSTART=0

# Custom install directory (default: auto-detect or %USERPROFILE%\openclaw)
# OPENCLAW_INSTALL_DIR=

# Gateway auth token (auto-generated if empty)
# OPENCLAW_GATEWAY_TOKEN=
